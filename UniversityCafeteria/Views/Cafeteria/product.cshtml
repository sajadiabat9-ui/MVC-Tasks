@section Styles {
    <link rel="stylesheet" href="~/css/products.css" />
}

@{
    string[] products = {
        "Water",
        "Orange Juice",
        "Coffee",
        "Sandwich",
        "Chocolate",
"Milk"
    };
}

<h2>Our Products</h2>

<ul>
    @foreach (string product in products)
    {
        <li>@product</li>
    }
</ul>

@{
    string category = "";

    switch (products[5])
    {
        case "Milk":
            category = "Dairy";
            break;

        default:
            category = "Other";
            break;
    }
    <p>New Product: @products[5]</p>
    <p>Category: @category</p>
}

@if (products.Length > 0)
{
    <p>We have Products.</p>
}
else
{
    <p>No Products available.</p>
}

@if (products.Length >= 3)
{
    <p>We have enough Products.</p>
}
else
{
    <p>We need more Products.</p>
}


@section Scripts {
    <script>
        alert("Welcome to the Products Page!");
    </script>
}





@{
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

@{
    string[] products = (string[])ViewData["Products"];
}

<h2>@ViewData["PageTitle"]</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card p-3">
            <h5>Manager Name</h5>
            <p>@ViewData["ManagerName"]</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h5>Number of Products</h5>
            <p>@ViewData["NumberOfProducts"]</p>
        </div>
    </div>

</div>

<h3 class="mt-4">Available Products</h3>

<div class="row">
    @foreach (string product in products)
    {
        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h5>@product</h5>
            </div>
        </div>
    }
</div>

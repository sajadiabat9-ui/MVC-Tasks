@{
}

<h2>@ViewBag.PageTitle</h2>

<p>Number of Suppliers: @ViewBag.NumberOfSuppliers</p>

<h3>Suppliers List:</h3>

<ul>
    @foreach (string supplier in ViewBag.Suppliers)
    {
        <li>@supplier</li>
    }
</ul>
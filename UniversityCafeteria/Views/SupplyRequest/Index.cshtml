@{
}

@{
    ViewData["Title"] = "Create Supply Request";
}

<h1>Create Supply Request</h1>

<form action="@Url.Action("AddItem", "SupplyRequest")" method="post">

    <div>
        <label>Product Name</label>
        <input type="text" name="productName" required />
    </div>

    <div>
        <label>Category</label>
        <select name="category" required>
            <option value="">Select Category</option>
            <option value="Drinks">Drinks</option>
            <option value="Food">Food</option>
            <option value="Dairy">Dairy</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div>
        <label>Quantity</label>
        <input type="number" name="quantity" min="1" required />
    </div>

    <div>
        <label>Unit Price</label>
        <input type="number" name="unitPrice" min="0.01" step="0.01" required />
    </div>

    <div>
        <select name="priority" required>
            <option value="Normal" selected="@(ViewBag.PreferredPriority == "Normal")">Normal</option>

            <option value="Urgent" selected="@(ViewBag.PreferredPriority == "Urgent")">Urgent</option>

            <option value="Emergency" selected="@(ViewBag.PreferredPriority == "Emergency")">Emergency</option>
        </select>
    </div>

    <button type="submit">Add Product</button>

</form>

<a href="@Url.Action("Review", "SupplyRequest")">
    Review Request
</a>
<h2>Save Preferred Priority</h2>

<form action="@Url.Action("SavePreference", "SupplyRequest")" method="post">

    <label>Preferred Priority</label>

    <select name="priority">
        <option value="Normal">Normal</option>
        <option value="Urgent">Urgent</option>
        <option value="Emergency">Emergency</option>
    </select>

    <button type="submit">Save Preference</button>

</form>

@if (ViewBag.PreferredPriority != null)
{
    <p>Your saved priority is: @ViewBag.PreferredPriority</p>
}
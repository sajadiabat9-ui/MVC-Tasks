@{
}
@model List<UniversityCafeteria.Models.SupplyRequest>

<h1>My Requests</h1>

@if (Model.Count == 0)
{
    <p>No confirmed requests yet.</p>
}
else
{
    @foreach (var request in Model)
    {
        <h2>Request #@request.RequestID</h2>

        <table border="1">
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Cost</th>
            </tr>

            @foreach (var item in request.Products)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice</td>
                    <td>@item.TotalCost</td>
                </tr>
            }
        </table>

        <p>Subtotal: @request.Subtotal JD</p>
        <p>Preparation Fee: @request.PreparationFee JD</p>
        <p>Discount: @request.Discount JD</p>
        <h3>Final Total: @request.FinalTotal JD</h3>

        <hr />
    }
}
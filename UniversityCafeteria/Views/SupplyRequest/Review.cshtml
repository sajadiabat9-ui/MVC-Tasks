@{
}

@model List<UniversityCafeteria.Models.SupplyItem>

<h1>Review Supply Request</h1>

@if (Model.Count == 0)
{
    <p>No products added yet.</p>
}
else
{
    <table border="1">
        <tr>
            <th>Product Name</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Priority</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.Priority</td>
            </tr>
        }
    </table>
}

<h2>Request Summary</h2>

<p>Subtotal: @ViewBag.Subtotal JD</p>

<p>Preparation Fee: @ViewBag.PreparationFee JD</p>

<p>Discount: @ViewBag.Discount JD</p>

<h3>Final Total: @ViewBag.FinalTotal JD</h3>

<a href="@Url.Action("Index", "SupplyRequest")">Add Another Product</a>

<form action="@Url.Action("ConfirmRequest", "SupplyRequest")" method="post">
    <button type="submit">Confirm Request</button>
</form>

<form action="@Url.Action("ClearDraft", "SupplyRequest")" method="post">
    <button type="submit">Clear Draft</button>
</form>
@{
}
@model List<Category> //اسم الكلاس

    <a href="@Url.Action("Create", "Category")" class="btn-outline-secondary">Create New</a>
<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Description</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
        </tr>
    }
</table>
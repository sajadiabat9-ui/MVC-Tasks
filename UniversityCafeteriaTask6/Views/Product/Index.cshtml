@{
}
@using UniversityCafeteriaTask6.Models
@model List<Product>

<h2>Products</h2>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>CategoryId</th>
        <th>SupplierId</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>@item.CategoryId</td>
            <td>@item.SupplierId</td>
        </tr>
    }
</table>
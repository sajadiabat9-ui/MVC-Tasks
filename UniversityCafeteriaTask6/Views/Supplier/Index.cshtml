
@using UniversityCafeteriaTask6.Models
@model List<Supplier>

<h2>Suppliers</h2>

<a asp-action="Create">Add New Supplier</a>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Address</th>
        <th>Products Count</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.Address</td>

            <td>
                @{
                    int count = 0;

                    foreach (var product in ViewBag.Products)
                    {
                        if (product.SupplierId == item.Id)
                        {
                            count++;
                        }
                    }
                }
                @count
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |

                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |

                <a asp-action="Delete" asp-route-id="@item.Id"
                   onclick="return confirm('Are you sure?')">Delete</a>
            </td>
        </tr>
    }
</table>

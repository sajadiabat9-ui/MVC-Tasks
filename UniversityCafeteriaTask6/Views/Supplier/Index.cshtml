@{
}

@model List<Supplier>
<h2>Suppliers</h2>
<a href="@Url.Action("Create", "Supplier")" class="btn-outline-secondary">Create New</a>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
        </tr>
    }
</table>
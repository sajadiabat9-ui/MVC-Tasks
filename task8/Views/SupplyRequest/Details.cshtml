@model task8.Models.SupplyRequest

<h2>Request Details</h2>

<p><strong>Request ID:</strong> @Model.Id</p>
<p><strong>Date:</strong> @Model.RequestDate</p>
<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Total:</strong> @Model.TotalPrice JD</p>

<table class="table table-bordered">
    <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Unit Price</th>
        <th>Total</th>
    </tr>

    @foreach (var item in Model.RequestItems)
    {
        <tr>
            <td>@item.Product.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Price JD</td>
            <td>@(item.Price * item.Quantity) JD</td>
        </tr>
    }
</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>

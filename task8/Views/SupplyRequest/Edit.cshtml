@model task8.Models.SupplyRequest
@using task8.Models

<h2>Edit Supply Request</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">

    @Html.AntiForgeryToken()

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Product product in ViewBag.Products)
            {
                var item = Model.RequestItems
                    .FirstOrDefault(x => x.ProductId == product.Id);

                int quantity = 0;

                if (item != null)
                {
                    quantity = item.Quantity;
                }

                <tr>
                    <td>
                        @product.Name

                        <input type="hidden"
                               name="productIds"
                               value="@product.Id" />
                    </td>

                    <td>@product.Price JD</td>

                    <td>
                        <input type="number"
                               name="quantities"
                               value="@quantity"
                               min="0"
                               max="@product.Quantity"
                               class="form-control" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

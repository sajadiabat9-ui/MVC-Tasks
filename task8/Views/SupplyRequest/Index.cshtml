@{
}

@model List<task8.Models.SupplyRequest>

<h2>Supply Requests</h2>

<a asp-action="Create" class="btn btn-primary">Create Request</a>

<table class="table table-bordered mt-3">
    <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Total</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>

    @foreach (var request in Model)
    {
        <tr>
            <td>@request.Id</td>
            <td>@request.RequestDate</td>
            <td>@request.TotalPrice JD</td>
            <td>@request.Status</td>
            
               
                <td>
                    <a asp-action="Details"
                       asp-route-id="@request.Id">
                        Details
                    </a>

                    @if (request.Status == "Pending")
                    {
                        <a asp-action="Edit"
                           asp-route-id="@request.Id">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@request.Id">
                            Delete
                        </a>
                    }
                </td>

            
        </tr>
    }
</table>
